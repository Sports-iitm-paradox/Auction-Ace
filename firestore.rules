
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can only manage their own profile
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    // Players are publicly readable for the auction, but only owners can manage them
    match /players/{playerId} {
      allow read: if true;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth.uid == resource.data.userId;
    }
    
    // Anyone can view the sets.
    match /sets/{setId} {
      allow get, list: if true;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth.uid == resource.data.userId;
    }

    // Active auction state is publicly viewable; only the owner can modify
    match /activeAuctions/{auctionId} {
      allow read: if true;
      allow create, update, delete: if request.auth.uid == request.resource.data.userId || (resource != null && request.auth.uid == resource.data.userId);
    }

    // Squad standings are publicly viewable
    match /squads/{houseId} {
      allow read: if true;
      allow write: if request.auth.uid != null;
    }
  }
}
